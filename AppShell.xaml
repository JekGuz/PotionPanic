<?xml version="1.0" encoding="UTF-8"?>
<Shell
    x:Class="PotionPanic.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PotionPanic.Views"
    Shell.NavBarIsVisible="False"
    FlyoutBehavior="Disabled">

    <!-- Только маршруты. Без TabBar и без Intro (Intro вне Shell). -->
    <ShellContent Route="menu"   ContentTemplate="{DataTemplate views:MenuPage}" />
    <ShellContent Route="game"   ContentTemplate="{DataTemplate views:GamePage}" />
    <ShellContent Route="results" ContentTemplate="{DataTemplate views:ResultsPage}" />
</Shell>
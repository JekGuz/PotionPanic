<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PotionPanic.Views.ResultsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:PotionPanic.Resources"
    xmlns:viewmodels="clr-namespace:PotionPanic.ViewModels"
    Title="{x:Static res:AppResources.Results}"
    BackgroundColor="{StaticResource PrimaryNavy}">

    <!-- VM -->
    <ContentPage.BindingContext>
        <viewmodels:ResultsViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <!-- фон как в меню -->
        <Image Source="fon4.png" Aspect="AspectFill" InputTransparent="True" />
        <BoxView Color="#660B1630" InputTransparent="True" />

        <VerticalStackLayout Spacing="16" Padding="16">

            <Label Style="{StaticResource TitleLabel}"
                   Text="{x:Static res:AppResources.Results}" />

            <!-- Список результатов + футер-кнопки -->
            <CollectionView ItemsSource="{Binding Items}"
                            ItemsLayout="VerticalList"
                            Margin="0,0,0,8">
                <CollectionView.EmptyView>
                    <Label Text="No results yet"
                           HorizontalOptions="Center"
                           TextColor="White"
                           Opacity="0.9"
                           Margin="0,20,0,0"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,6"
                               Padding="12"
                               BackgroundColor="#22000000"
                               BorderColor="#F2E205"
                               CornerRadius="14"
                               HasShadow="False">
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto">
                                <!-- Очки -->
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Score}"
                                       TextColor="#F2E205"
                                       FontAttributes="Bold"
                                       FontSize="20" />
                                <!-- Длительность -->
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding DurationSec, StringFormat='{0}s'}"
                                       TextColor="LightGray"
                                       FontSize="12" />
                                <!-- Имя и дата -->
                                <Label Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="{Binding PlayerName}"
                                       TextColor="#F2E205"
                                       FontAttributes="Bold"
                                       FontSize="13" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- ФУТЕР С КНОПКАМИ (скроллится вместе со списком) -->
                <CollectionView.Footer>
                    <Grid Padding="16,12,16,28">
                        <HorizontalStackLayout Spacing="12"
                                               HorizontalOptions="Center">
                            <Button Text="{x:Static res:AppResources.BackToMenu}"
                                    Style="{StaticResource GoldButton}"
                                    Command="{Binding BackToMenuCommand}"
                                    Shadow="{StaticResource SoftGoldGlow}" />

                            <Button Text="{x:Static res:AppResources.Refresh}"
                                    Style="{StaticResource GoldButton}"
                                    Command="{Binding RefreshCommand}"
                                    Shadow="{StaticResource SoftGoldGlow}" />

                            <Button Text="{x:Static res:AppResources.Clear}"
                                    BackgroundColor="#F25C05"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    Command="{Binding ClearCommand}" />
                        </HorizontalStackLayout>
                    </Grid>
                </CollectionView.Footer>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>

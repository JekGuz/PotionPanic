<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PotionPanic.Views.MenuPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:PotionPanic.Resources"
    Title="{x:Static res:AppResources.Title}"
    BackgroundColor="{StaticResource PrimaryNavy}">

    <Grid>
        <Image Source="fon4.png" Aspect="AspectFill" InputTransparent="True" />
        <BoxView Color="#660B1630" InputTransparent="True" />

        <VerticalStackLayout Spacing="16" Padding="16">
            <Label x:Name="TitleLabel"
                   Style="{StaticResource TitleLabel}"
                   Text="{x:Static res:AppResources.Title}" />

            <!-- Кнопки -->
            <Button x:Name="StartBtn"
                    Style="{StaticResource GoldButton}"
                    Clicked="StartBtn_Clicked"
                    Shadow="{StaticResource SoftGoldGlow}"/>

            <Button x:Name="ChallengeBtn"
                    Style="{StaticResource GoldButton}"
                    Clicked="ChallengeBtn_Clicked"
                    Shadow="{StaticResource SoftGoldGlow}"/>

            <Button x:Name="ResultsBtn"
                    Style="{StaticResource GoldButton}"
                    Clicked="ResultsBtn_Clicked"
                    Shadow="{StaticResource SoftGoldGlow}"/>

            <!-- Флажки -->
            <HorizontalStackLayout Spacing="12" Margin="0,24,0,0" 
                                   HorizontalOptions="Center">
                <ImageButton x:Name="FlagEN" 
                             Source="flag_eng.png"
                             BackgroundColor="Transparent" 
                             WidthRequest="55" 
                             HeightRequest="55" 
                             Padding="0"
                             Clicked="LangEn_Clicked"  
                             SemanticProperties.Description="English"
                             Shadow="{StaticResource SoftGoldGlow}"/>
                <ImageButton x:Name="FlagRU" 
                             Source="flag_ru.png"
                             BackgroundColor="Transparent" 
                             WidthRequest="55" HeightRequest="55" 
                             Padding="0"
                             Clicked="LangRu_Clicked"  
                             SemanticProperties.Description="Русский"
                             Shadow="{StaticResource SoftGoldGlow}"/>
                <ImageButton x:Name="FlagET" 
                             Source="flag_ee.png"
                             BackgroundColor="Transparent" 
                             WidthRequest="55" 
                             HeightRequest="55" 
                             Padding="0"
                             Clicked="LangEt_Clicked"  
                             SemanticProperties.Description="Eesti"
                             Shadow="{StaticResource SoftGoldGlow}"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
